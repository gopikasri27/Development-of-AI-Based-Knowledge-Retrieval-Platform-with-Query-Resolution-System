# ========================================================
# AutoRAG Knowledge Platform Configuration (.env)
# ========================================================

# Google Gemini API Key (Optional: system uses local synthesis fallback if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Name (Default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Sentence Transformer Embedding Model (Default: all-MiniLM-L6-v2)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Persistent Vector Store Directory Path
CHROMA_PERSIST_DIR=./vectorstore

# Clarification Agent Confidence Threshold (0.0 to 1.0)
SIMILARITY_THRESHOLD=0.50

# Flask Server Port & Environment
PORT=5000
FLASK_ENV=development
